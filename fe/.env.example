# The Vite dev server proxies /api to VITE_API_PROXY_TARGET, so browser requests stay
# same-origin and the session cookie is first-party. Keep VITE_API_BASE_URL=/api/v1 in
# every environment (in production, a Vercel rewrite proxies /api to the backend).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Explicitly opt into illustrative local data when the backend is unavailable.
VITE_DEMO_MODE=false
