# The Vite dev server proxies /api to http://localhost:8000 by default.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional single-owner development seam. Never place service-role keys or OAuth secrets here.
VITE_OWNER_ID=

# Explicitly opt into illustrative local data when the backend is unavailable.
VITE_DEMO_MODE=false
