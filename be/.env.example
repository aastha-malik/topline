# =============================================================================
# Topline backend - environment configuration
#
#   cp .env.example .env   and fill in the values marked REQUIRED.
#   Never commit .env. Secrets come from the environment only.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=topline-api
ENVIRONMENT=local                  # local | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json in deployment, console for local reading
CORS_ORIGINS=http://localhost:5173

# --- Database: Supabase Postgres --------------------------------------------
# REQUIRED. Use the Supabase **session pooler** URI (Project Settings -> Database
# -> Connection string -> Session pooler), and URL-encode any special characters
# in the password. A plain `postgresql://` prefix is upgraded to asyncpg
# automatically.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Supabase project --------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # server-side only; never ship to the frontend
SUPABASE_JWT_SECRET=               # needed when Supabase Auth verification is wired up

# --- Secrets at rest ---------------------------------------------------------
# REQUIRED. Encrypts stored Gmail OAuth tokens. Generate with:
#     python -m app.keygen
# Rotating this key invalidates every stored token: mailboxes must be reconnected.
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth / Gmail ----------------------------------------------------
# REQUIRED to connect a mailbox. Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID (Web application). Enable the Gmail API, and add
# the owner and customer test accounts as OAuth test users.
#
# Scopes requested: openid, email, profile, gmail.readonly, gmail.send.
# `gmail.modify` is deliberately never requested - the app refuses to start if a
# write scope is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_POST_AUTH_REDIRECT=http://localhost:5173/connect
ENABLE_GMAIL_SEND_SCOPE=true       # provisioned for the later approval-gated sender
OAUTH_STATE_TTL_SECONDS=600

# --- Gmail ingestion tuning --------------------------------------------------
BACKFILL_MONTHS=12                 # history window for the initial backfill
GMAIL_LIST_PAGE_SIZE=100
GMAIL_MAX_MESSAGES_PER_RUN=2000    # hard cap per sync run
GMAIL_MAX_ATTACHMENT_BYTES=15728640
FALLBACK_RESYNC_DAYS=14            # window re-scanned when the history id expires
RELEVANCE_THRESHOLD=40             # 0-100; below this a message is ignored, body never fetched
MAX_STORED_BODY_CHARS=20000        # evidence is retained, whole mailboxes are not
MAX_STORED_PDF_CHARS=60000
OCR_TRIGGER_CHARS_PER_PAGE=40      # below this per page, a PDF is treated as scanned
ENABLE_OCR_FALLBACK=true           # needs pytesseract + tesseract-ocr; degrades gracefully

# --- Ledger / decision engine ------------------------------------------------
DEFAULT_PAYMENT_TERMS_DAYS=15      # used when an invoice states no due date
REMINDER_GRACE_DAYS=0              # days past due before an invoice becomes actionable
REMINDER_COOLDOWN_DAYS=3           # minimum gap between reminders for one invoice
DEFAULT_CURRENCY=INR

# --- Razorpay (optional confirmation source; test mode for the demo) ----------
# Razorpay is the only source allowed to mark an invoice `confirmed_paid`.
# Dashboard -> Settings -> Webhooks; point it at
#   POST {PUBLIC_URL}/api/v1/webhooks/razorpay
# and subscribe to payment.captured, payment.failed, invoice.paid, refund.created.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Agent layer (owned by the agent developer) ------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DIGEST_HOUR_IST=9
ENABLE_SCHEDULER=false
